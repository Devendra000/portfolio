# Contact form (app/api/contact/route.ts) sends mail through Resend's HTTP API.
# Get a key at https://resend.com/api-keys.
RESEND_API_KEY=
# Optional. Without a verified domain, keep the default shared sender — it can
# only deliver to the email address that owns your Resend account.
MAIL_FROM="Portfolio Contact <onboarding@resend.dev>"
# Optional. Defaults to site.email in lib/site-config.ts.
CONTACT_TO=

# ---- Job application tracker (/tracker, /api/applications) ----
# Owner password hash: node scripts/hash-password.mjs 'your-long-password'
ADMIN_PASSWORD_HASH=
# Signs the session cookie: openssl rand -base64 32
SESSION_SECRET=
# DynamoDB table (pk: String partition key, sk: String sort key; TTL on `ttl`)
TRACKER_TABLE=job-applications
TRACKER_AWS_REGION=ap-south-1
# Local dev only: Floci endpoint (with any dummy keys, e.g. "test"). Unset in production.
TRACKER_DYNAMODB_ENDPOINT=
# IAM user limited to this table. Custom names because Vercel reserves AWS_*.
TRACKER_AWS_ACCESS_KEY_ID=
TRACKER_AWS_SECRET_ACCESS_KEY=

# ---- Bill uploads: Cloudflare Worker + R2 (workers/tracker-bills) ----
# Local: `pnpm bills:dev` and put the same secret in workers/tracker-bills/.dev.vars
# Prod:  the workers.dev URL from `pnpm bills:deploy`; secret = the Worker's SHARED_SECRET
BILLS_WORKER_URL=http://localhost:8787
BILLS_WORKER_SECRET=
