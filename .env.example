# Contact form (app/api/contact/route.ts) sends mail through Resend's HTTP API.
# Get a key at https://resend.com/api-keys.
RESEND_API_KEY=
# Optional. Without a verified domain, keep the default shared sender — it can
# only deliver to the email address that owns your Resend account.
MAIL_FROM="Portfolio Contact <onboarding@resend.dev>"
# Optional. Defaults to site.email in lib/site-config.ts.
CONTACT_TO=
